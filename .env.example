# ─── apps/web (copy to apps/web/.env.local) ──────────────────────────────
# Auth.js secret: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Shared HS256 secret used to sign game tokens; must match the server. 32+ characters.
GAME_JWT_SECRET=
# Where the browser reaches the game server (http(s) URL; the SDK switches to ws(s))
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:2567
# Dev-only guest sign-in for local multi-window testing. Ignored when NODE_ENV=production.
AUTH_DEV_LOGIN=false

# ─── apps/server (copy to apps/server/.env) ──────────────────────────────
PORT=2567
# Same value as the web app's GAME_JWT_SECRET
# GAME_JWT_SECRET=
# Comma-separated list of web origins allowed to open WebSockets / call HTTP routes
ALLOWED_ORIGINS=http://localhost:3000
# Directory for saved tables ("keep table for later"); mount a volume here in production
DATA_DIR=./data
# debug | info | warn | error
LOG_LEVEL=info
